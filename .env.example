# SocialData API key (https://socialdata.tools/) - Bearer token
SOCIALDATA_API_KEY=

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Telegram Bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Per-Pipeline configuration (X List ID + Telegram Chat ID per pipeline) lives in
# pipelines.json at the repo root. See README.md.

# Directory for the Tweet Store (date-scoped JSON files) and cursor.json
# Defaults to ./store relative to the working directory
STORE_DIR=./store

# Optional Jev source review after Gemini. Original generation keeps text/images.
# Enable only after adding a TypeSafe API key: https://console.typesafe.ai/
JEV_ENABLED=false
TYPESAFE_API_KEY=
# Pin a version for repeatable annotations; changing model invalidates the cache.
JEV_MODEL=jev-1.13.0

# review (default): audit and selectively repair one draft; annotate: legacy labels
JEV_MODE=review
